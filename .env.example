# Copy to .env for local dev, and add the same keys in the Cloudflare Pages
# dashboard under Settings > Environment variables.
# NEVER commit real values. Nothing here is exposed to the browser except
# TURNSTILE_SITE_KEY, which is public by design.

# Where validated leads are POSTed as JSON. Point this at your Zapier catch hook
# which then creates the lead in Lofty.
LEAD_WEBHOOK_URL=

# Cloudflare Turnstile. Create a widget at dash.cloudflare.com > Turnstile.
# The site key is public and rendered in the form markup.
TURNSTILE_SITE_KEY=
# The secret key is server side only. Never reference it in src/.
TURNSTILE_SECRET_KEY=
