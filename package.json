{
  "name": "kirbychanmarkham",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:style": "node scripts/check-style.mjs",
    "clean:cache": "node -e \"const fs=require('fs');for(const d of ['.astro','node_modules/.astro','dist']) fs.rmSync(d,{recursive:true,force:true})\"",
    "verify": "npm run clean:cache && npm run check:style && npm run check:blog && npm run check:translations && npm run check && npm run build && npm run check:links && npm run check:thin",
    "astro": "astro",
    "check:blog": "node scripts/check-blog.mjs",
    "check:thin": "node scripts/check-thin.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "dev:cms": "tinacms dev -c \"astro dev\""
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.0",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.6.0",
    "sharp": "^0.33.5",
    "tinacms": "^3.14.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tinacms/cli": "^3.0.0",
    "@tinacms/mdx": "^2.2.3",
    "@types/react": "^18.3.31",
    "@types/turndown": "^5.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.7.3",
