---
import { BLOG_CATEGORIES, type BlogCategory } from '../lib/blog';
import { longDate } from '../lib/format';

interface Props {
  slug: string;
  title: string;
  subtitle?: string;
  category: BlogCategory;
  published: Date;
  /** Heading level for the card title, so lists keep a correct outline. */
  level?: 2 | 3;
}
const { slug, title, subtitle, category, published, level = 3 } = Astro.props;
const Tag = `h${level}` as 'h2' | 'h3';
---

<a class="bcard" href={`/blog/${slug}/`}>
  <span class="bcard__meta">
    <span class="bcard__cat">{BLOG_CATEGORIES[category]}</span>
    <span aria-hidden="true">&middot;</span>
    <time datetime={published.toISOString()}>{longDate(published)}</time>
  </span>
  <Tag class="bcard__title">{title}</Tag>
  {subtitle && <span class="bcard__sub">{subtitle}</span>}
  <span class="bcard__cta" aria-hidden="true">Read the post <span class="bcard__arrow">&rarr;</span></span>
</a>

<style>
  .bcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    height: 100%;
    padding: var(--sp-6);
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .bcard::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--brand), var(--brass));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .bcard:hover,
  .bcard:focus-visible {
    transform: translateY(-4px);
    border-color: var(--brass-soft);
    box-shadow: 0 18px 36px -18px rgba(16, 37, 31, 0.35);
  }
  .bcard:hover::before,
  .bcard:focus-visible::before {
    transform: scaleX(1);
  }
  .bcard__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .bcard__cat {
    font-weight: 700;
    color: var(--brand);
  }
  .bcard__title {
    font-size: var(--step-1);
    line-height: 1.3;
    margin: 0;
  }
  .bcard__sub {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-muted);
    flex: 1;
  }
  .bcard__cta {
    margin-top: var(--sp-2);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--brand);
  }
  .bcard__arrow {
    display: inline-block;
    transition: transform 0.25s var(--ease);
  }
  .bcard:hover .bcard__arrow {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .bcard:hover,
    .bcard:focus-visible {
      transform: none;
    }
  }
</style>
