---
/** The four one-click steps (home type, neighbourhood, price, bedrooms). Wired up by src/scripts/home-search.ts. */
import { AREAS, HOMES, PRICES } from '../lib/proptx';

interface Props {
  /** Label for the price step: asking price or sold price. */
  priceLabel?: string;
}
const { priceLabel = 'Your price' } = Astro.props;
const BEDS = ['1', '2', '3', '4'];
---

<div class="hs__step">
  <h2><span class="hs__num">1</span> What kind of home?</h2>
  <div class="hs__choices hs__choices--tiles">
    <a class="hs__choice" data-key="home" data-value="" href="?">
      <strong>Any home</strong><span>Show everything</span>
    </a>
    {Object.entries(HOMES).map(([k, h]) => (
      <a class="hs__choice" data-key="home" data-value={k} href={`?home=${k}`}>
        <strong>{h.label}</strong><span>{h.hint}</span>
      </a>
    ))}
  </div>
</div>

<div class="hs__step" id="area-step">
  <h2><span class="hs__num">2</span> Where in Markham? <small>(optional)</small></h2>
  <div class="hs__choices">
    <a class="hs__choice" data-key="area" data-value="" href="?"><strong>All of Markham</strong></a>
    {Object.entries(AREAS).map(([k, a]) => (
      <a class="hs__choice" data-key="area" data-value={k} href={`?area=${k}`}><strong>{a.label}</strong></a>
    ))}
  </div>
</div>

<div class="hs__step">
  <h2><span class="hs__num">3</span> {priceLabel} <small>(optional)</small></h2>
  <div class="hs__choices">
    <a class="hs__choice" data-key="price" data-value="" href="?"><strong>Any price</strong></a>
    {Object.entries(PRICES).map(([k, p]) => (
      <a class="hs__choice" data-key="price" data-value={k} href={`?price=${k}`}><strong>{p.label}</strong></a>
    ))}
  </div>
</div>

<div class="hs__step">
  <h2><span class="hs__num">4</span> Bedrooms <small>(optional)</small></h2>
  <div class="hs__choices">
    <a class="hs__choice" data-key="beds" data-value="" href="?"><strong>Any</strong></a>
    {BEDS.map((b) => (
      <a class="hs__choice" data-key="beds" data-value={b} href={`?beds=${b}`}><strong>{b} or more</strong></a>
    ))}
  </div>
</div>

<slot />
