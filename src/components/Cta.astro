---
import Accent from './Accent.astro';
import site from '../data/site.json';

interface Props {
  heading?: string;
  accent?: string;
  body?: string;
  tone?: 'dark' | 'light';
}
const {
  heading = 'Book a 30-minute conversation',
  accent = '30-minute',
  body = 'No pitch and no pressure. Tell us the situation and we will tell you plainly whether we are the right people for it.',
  tone = 'dark',
} = Astro.props;

const bookingHref = site.links.booking || '/contact/';
const bookingExternal = bookingHref.startsWith('http');
---

<section class:list={['cta', tone === 'dark' ? 'section--dark on-dark' : 'cta--light']}>
  <div class="wrap cta__inner">
    <div>
      <h2>
        <Accent text={heading} accent={accent} />
      </h2>
      <p class="lede">{body}</p>
    </div>
    <div class="cta__actions">
      <a
        class="btn btn--gold"
        href={bookingHref}
        rel={bookingExternal ? 'noopener' : undefined}
        target={bookingExternal ? '_blank' : undefined}
      >
        Book a conversation{
          bookingExternal && <span class="visually-hidden"> (opens in a new tab)</span>
        }
      </a>
      <a class="btn btn--ghost" href={site.contact.phoneHref}>Call {site.contact.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--section-y);
  }
  .cta--light {
    background: var(--sand);
    border-block: 1px solid var(--rule);
  }
  .cta__inner {
    display: grid;
    gap: var(--sp-6);
    align-items: center;
  }
  .cta h2 {
    max-width: 18ch;
  }
  .cta .lede {
    margin-top: var(--sp-4);
    max-width: 52ch;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  @media (min-width: 880px) {
    .cta__inner {
      grid-template-columns: 1.3fr auto;
      gap: var(--sp-8);
    }
    .cta__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
