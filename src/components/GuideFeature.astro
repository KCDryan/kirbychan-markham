---
import { Image } from 'astro:assets';
import { photo, photoAlt } from '../lib/photos';

// The two pillar guides, featured high on the home page so they carry the
// most internal link weight on the site.
const cards = [
  {
    href: '/downsizing-markham/',
    eyebrow: 'Guide',
    title: 'Downsizing in Markham',
    body: 'Planning the move from a long-time family home: timing, costs, where people move in Markham and how to sell well without rushing.',
    cta: 'Read the downsizing guide',
    image: photo('neighbourhoods/markham-village'),
    imageAlt: photoAlt('markham-village'),
  },
  {
    href: '/first-time-home-buyers-markham/',
    eyebrow: 'Service',
    title: 'First-time home buyers in Markham',
    body: 'A real budget, a realistic neighbourhood list and no surprises at closing, plus our posts on land transfer tax, closing costs and the FHSA.',
    cta: 'How we help first-time buyers',
    image: photo('neighbourhoods/cornell'),
    imageAlt: photoAlt('cornell'),
  },
];
---

<section class="gfeat section" aria-labelledby="gfeat-heading">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Start here</p>
      <h2 id="gfeat-heading">Planning your next move in Markham</h2>
    </div>
    <ul class="gfeat__grid" role="list">
      {
        cards.map((c) => (
          <li>
            <a class="gfeat__card" href={c.href}>
              {c.image && (
                <Image class="gfeat__img" src={c.image} alt={c.imageAlt ?? ''} widths={[480, 800]} sizes="(min-width: 900px) 560px, 100vw" loading="lazy" />
              )}
              <span class="gfeat__body">
                <span class="eyebrow">{c.eyebrow}</span>
                <h3>{c.title}</h3>
                <span class="gfeat__text">{c.body}</span>
                <span class="gfeat__cta">
                  {c.cta} <span aria-hidden="true">&rarr;</span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gfeat__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: var(--sp-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .gfeat__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  .gfeat__card:hover,
  .gfeat__card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px -18px rgba(16, 37, 31, 0.35);
  }
  .gfeat__card :global(.gfeat__img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 7;
    object-fit: cover;
  }
  .gfeat__body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    flex: 1;
    padding: var(--sp-6);
  }
  .gfeat__body h3 {
    margin: 0;
    font-size: var(--step-2);
  }
  .gfeat__text {
    flex: 1;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .gfeat__cta {
    font-weight: 700;
    color: var(--brand);
  }
  @media (prefers-reduced-motion: reduce) {
    .gfeat__card:hover,
    .gfeat__card:focus-visible {
      transform: none;
    }
  }
</style>
