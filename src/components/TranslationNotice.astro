---
import { langFromPath, t } from '../i18n';

// Shown on translated pages. It says the page is a translation, that the
// English version applies and which languages the team actually works in.
const dict = t(langFromPath(Astro.url.pathname));
---

<aside class="tnotice" aria-label={dict.ui.lang.button}>
  <div class="wrap tnotice__inner">
    <svg class="tnotice__icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
    </svg>
    <div>
      <p>{dict.notice.team}</p>
      <p class="tnotice__small">{dict.notice.translation}</p>
    </div>
  </div>
</aside>

<style>
  .tnotice {
    background: var(--mist);
    border-bottom: 1px solid var(--rule);
  }
  .tnotice__inner {
    display: flex;
    gap: var(--sp-4);
    align-items: flex-start;
    padding-block: var(--sp-5);
  }
  .tnotice__icon {
    flex: none;
    margin-top: 0.2rem;
    fill: none;
    stroke: var(--brand);
    stroke-width: 1.6;
  }
  .tnotice p {
    margin: 0;
    max-width: 80ch;
  }
  .tnotice__small {
    margin-top: 0.35rem !important;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
