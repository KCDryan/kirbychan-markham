---
import { getCollection } from 'astro:content';
import { servicePath } from '../lib/guides';
import { langFromPath, localePath, t } from '../i18n';

interface Props {
  limit?: number;
  exclude?: string;
  only?: string[];
  /** Show the longer description under each card title. */
  detailed?: boolean;
  /** Heading level for the card names. */
  level?: 2 | 3;
}
const { limit, exclude, only, detailed = false , level = 3 } = Astro.props;
const Name = `h${level}` as 'h2' | 'h3';

const lang = langFromPath(Astro.url.pathname);
const dict = t(lang);

interface Card {
  key: string;
  name: string;
  summary: string;
  body: string;
  href: string;
}

const collection = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

// Buying and selling lead the grid and link to their own pages. Every other
// card is a service page in English, or an anchor on the translated services
// page in other languages.
const keys = ['buying', 'selling', ...collection.map((s) => s.id)];
let cards: Card[] = keys.map((key) => {
  const tr = (dict.services.items as Record<string, { name: string; summary: string; body: string }>)[key];
  const entry = collection.find((s) => s.id === key);
  const englishHref = key === 'buying' ? '/buyers/' : key === 'selling' ? '/sellers/' : servicePath(key);
  return {
    key,
    name: lang === 'en' ? (entry?.data.name ?? tr?.name ?? key) : (tr?.name ?? entry?.data.name ?? key),
    summary: tr?.summary ?? entry?.data.summary ?? '',
    body: tr?.body ?? '',
    href: lang === 'en' || detailed ? englishHref : `${localePath(lang, '/services/')}#${key}`,
  };
});
if (only) cards = cards.filter((c) => only.includes(c.key));
if (exclude) cards = cards.filter((c) => c.key !== exclude);
if (limit) cards = cards.slice(0, limit);

// Simple line icons, drawn on a 24 unit grid.
const icons: Record<string, string> = {
  buying: '<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><circle cx="11" cy="14" r="2.2"/><path d="M12.6 15.6L15 18"/>',
  selling: '<path d="M4 20V4"/><path d="M4 5h13l-2.5 4L17 13H4"/><path d="M9 20h6"/>',
  luxury: '<path d="M3 9l3-5h12l3 5-9 11z"/><path d="M3 9h18M9 4l3 5 3-5M12 9v11"/>',
  relocation: '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  downsizing: '<rect x="3" y="3" width="11" height="11" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/><path d="M10 10l6 6M16 12v4h-4"/>',
  upsizing: '<rect x="3" y="13" width="8" height="8" rx="1"/><rect x="10" y="3" width="11" height="11" rx="1"/><path d="M8 16l7-7M11 9h4v4"/>',
  'first-time-buyers': '<circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M17 6l2 2M15 8l2 2"/>',
  'new-construction': '<path d="M3 21h18"/><path d="M6 21V10l6-5 6 5v11"/><path d="M10 21v-5h4v5"/><path d="M4 7l3-3h4"/>',
  investors: '<path d="M4 20V10M10 20V5M16 20v-7M22 20H2"/><path d="M4 8l6-5 6 7 5-4"/>',
  'estate-sales': '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M10 13h6M10 17h6"/>',
  'separation-and-divorce': '<path d="M12 20l-7-7a4.5 4.5 0 0 1 6.4-6.4l.6.6"/><path d="M12 20l7-7a4.5 4.5 0 0 0-6.4-6.4L12 7.2"/><path d="M12 7.2l-1.5 3.3 3 2-1.5 3"/>',
};
const fallbackIcon = '<circle cx="12" cy="12" r="8"/>';
---

<ul class:list={['svc-grid', detailed && 'svc-grid--detailed']} role="list">
  {
    cards.map((c) => (
      <li id={detailed ? c.key : undefined}>
        <a class="svc" href={c.href} hreflang={detailed && lang !== 'en' ? 'en-CA' : undefined}>
          <span class="svc__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" set:html={icons[c.key] ?? fallbackIcon} />
          </span>
          <Name class="svc__name">{c.name}</Name>
          <p class="svc__line">{c.summary}</p>
          {detailed && c.body && <p class="svc__body">{c.body}</p>}
          <span class="svc__cta">
            {detailed && lang !== 'en' ? dict.ui.englishPage : dict.ui.readMore}
            <span class="svc__arrow" aria-hidden="true">&rarr;</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: var(--sp-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .svc-grid > li {
    scroll-margin-top: 110px;
  }
  .svc {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: var(--sp-6);
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    box-shadow: 0 1px 2px rgba(16, 37, 31, 0.04);
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  /* A brass line that sweeps across the top edge on hover. */
  .svc::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--brand), var(--brass));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  :global([dir='rtl']) .svc::before {
    transform-origin: right;
  }
  .svc:hover,
  .svc:focus-visible {
    transform: translateY(-5px);
    border-color: var(--brass-soft);
    box-shadow: 0 18px 36px -18px rgba(16, 37, 31, 0.35);
  }
  .svc:hover::before,
  .svc:focus-visible::before {
    transform: scaleX(1);
  }
  .svc__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: var(--sp-2);
    border-radius: 14px;
    background: var(--mist);
    transition:
      transform 0.25s var(--ease),
      background 0.25s var(--ease);
  }
  .svc__icon svg {
    fill: none;
    stroke: var(--brand);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.25s var(--ease);
  }
  .svc:hover .svc__icon {
    transform: translateY(-2px) scale(1.06);
    background: var(--brand);
  }
  .svc:hover .svc__icon svg {
    stroke: var(--brass-soft);
  }
  .svc__name {
    font-size: var(--step-1);
    margin: 0;
  }
  .svc__line {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .svc-grid:not(.svc-grid--detailed) .svc__line,
  .svc__body {
    flex: 1;
  }
  .svc__body {
    font-size: 0.92rem;
    line-height: 1.65;
  }
  .svc__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: var(--sp-2);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--brand);
  }
  .svc__arrow {
    display: inline-block;
    transition: transform 0.25s var(--ease);
  }
  :global([dir='rtl']) .svc__arrow {
    transform: scaleX(-1);
  }
  .svc:hover .svc__arrow {
    transform: translateX(4px);
  }
  :global([dir='rtl']) .svc:hover .svc__arrow {
    transform: scaleX(-1) translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .svc:hover,
    .svc:focus-visible,
    .svc:hover .svc__icon {
      transform: none;
    }
  }
</style>
