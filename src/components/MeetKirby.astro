---
import Photo from './Photo.astro';
import site from '../data/site.json';
import { langFromPath, localePath, t } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const dict = t(lang);
const k = dict.home.kirby;
// The team members shown beside Kirby: English pages only, since their text is not translated.
const team = lang === 'en' ? site.team : [];
---

<section class="kirby section section--alt">
  <div class="wrap kirby__inner">
    <div class:list={['kirby__media', team.length > 0 && 'kirby__media--pair']}>
      <figure class="kirby__person">
        <Photo name="kirby-portrait" alt={dict.about.photoAlt} label="Portrait of Kirby Chan" ratio="1 / 1" sizes="(min-width: 880px) 220px, 45vw" />
        <figcaption class="broker-caption"><strong>Kirby Chan</strong>, Broker</figcaption>
      </figure>
      {
        team.map((m) => (
          <figure class="kirby__person">
            <a href={m.path} aria-label={`Meet ${m.name}`}>
              <Photo name={m.photo} alt={`${m.name}, ${m.title}`} label={`Portrait of ${m.name}`} ratio="1 / 1" sizes="(min-width: 880px) 220px, 45vw" />
            </a>
            <figcaption class="broker-caption"><strong>{m.name}</strong>, {m.title}</figcaption>
          </figure>
        ))
      }
    </div>
    <div class="kirby__copy">
      <p class="eyebrow">{k.eyebrow}</p>
      <h2>{k.h2}</h2>
      <p class="lede">{k.p1}</p>
      <p>{k.p2}</p>
      <blockquote class="kirby__quote">
        <p>{dict.about.quote}</p>
      </blockquote>
      {
        team.map((m) => (
          <p class="kirby__also">
            <strong>{m.name}</strong> is our main Markham agent. She speaks {m.languages.join(' and ')}. Call{' '}
            <a href={m.phoneHref}>{m.phone}</a> or <a href={m.path}>meet {m.name.split(' ')[0]}</a>.
          </p>
        ))
      }
      <a class="btn btn--primary" href={localePath(lang, '/about/')}>{k.button}</a>
    </div>
  </div>
</section>

<style>
  .kirby__inner {
    display: grid;
    gap: var(--sp-7);
    align-items: center;
  }
  .kirby__media {
    max-width: 380px;
    width: 100%;
  }
  .kirby__media--pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
    max-width: 480px;
  }
  .kirby__person {
    margin: 0;
  }
  .kirby__also {
    padding: var(--sp-4) var(--sp-5);
    background: #fff;
    border: 1px solid var(--rule);
    border-inline-start: 3px solid var(--brass);
    border-radius: var(--radius-lg);
  }
  .broker-caption {
    margin-top: var(--sp-3);
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .broker-caption strong {
    color: var(--ink);
    font-weight: 600;
  }
  .kirby__copy > p {
    margin-top: var(--sp-4);
  }
  .kirby__quote {
    margin: var(--sp-6) 0 0;
    padding-inline-start: var(--sp-5);
    border-inline-start: 3px solid var(--brass);
  }
  .kirby__quote p {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--brand);
  }
  .kirby__copy .btn {
    margin-top: var(--sp-6);
  }

  @media (min-width: 880px) {
    .kirby__inner {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--sp-8);
    }
  }
</style>
