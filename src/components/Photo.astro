---
/**
 * Renders a real photo from src/assets/photos/ when one exists for `name`,
 * optimised to AVIF and WebP at several widths with width and height set.
 * Otherwise renders the labelled placeholder, so a missing photo is visible
 * rather than broken.
 */
import { Picture } from 'astro:assets';
import Placeholder from './Placeholder.astro';
import { photo } from '../lib/photos';

interface Props {
  name: string;
  alt: string;
  /** Shown on the placeholder until the real photo exists. */
  label: string;
  ratio?: string;
  /** Above the fold images load eagerly. Everything else is lazy. */
  priority?: boolean;
  sizes?: string;
  /** Candidate widths. Wider than the file is clamped to the file. */
  widths?: number[];
  /** Encoder quality shared by every format. Omit to use the image service default. */
  quality?: number;
  /**
   * Format of the `<img>` fallback. A PNG source otherwise falls back to PNG,
   * which keeps a heavy file in the srcset even when AVIF and WebP are offered.
   */
  fallbackFormat?: 'avif' | 'webp' | 'png' | 'jpg';
  class?: string;
  /** Transparent cutout: no background panel, no crop. */
  cutout?: boolean;
}

const {
  name,
  alt,
  label,
  ratio = '4 / 3',
  priority = false,
  sizes = '(min-width: 900px) 440px, 100vw',
  widths = [400, 640, 880, 1200],
  quality,
  fallbackFormat,
  class: cls = '',
  cutout = false,
} = Astro.props;

const src = photo(name);
---

{
  src ? (
    <div class:list={['photo', cutout && 'photo--cutout', cls]} style={`aspect-ratio:${ratio}`}>
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        fallbackFormat={fallbackFormat}
        widths={widths}
        quality={quality}
        width={Math.min(Math.max(...widths), src.width)}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
    </div>
  ) : (
    <Placeholder label={label} ratio={ratio} class={cls} />
  )
}

<style>
  .photo {
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--mist);
  }
  .photo--cutout {
    background: transparent;
    border-radius: 0;
  }
  .photo--cutout :global(img) {
    object-fit: contain;
    object-position: bottom center;
  }
  .photo :global(picture),
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
