---
import { longDate } from '../lib/format';

interface Props {
  slug: string;
  title: string;
  subtitle?: string;
  published: Date;
  minutes: number;
}
const { slug, title, subtitle, published, minutes } = Astro.props;
---

<a class="acard" href={`/${slug}/`}>
  <span class="acard__meta">
    <time datetime={published.toISOString()}>{longDate(published)}</time>
    <span aria-hidden="true">&middot;</span>
    <span>{minutes} min read</span>
  </span>
  <h3 class="acard__title">{title}</h3>
  {subtitle && <span class="acard__sub">{subtitle}</span>}
  <span class="acard__cta" aria-hidden="true">Read the guide</span>
</a>

<style>
  .acard {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: var(--sp-5);
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  .acard:hover {
    border-color: var(--brass);
    box-shadow: var(--shadow);
  }
  .acard__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .acard__title {
    font-size: var(--step-1);
    margin: 0;
  }
  .acard__sub {
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--text-muted);
    flex: 1;
  }
  .acard__cta {
    margin-top: var(--sp-2);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand);
  }
</style>
