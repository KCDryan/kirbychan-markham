---
import { langFromPath, t } from '../i18n';

// Figures published by the team on kirbychanandco.com. Change them in
// src/i18n/en.json and each translation when the counts change.
const dict = t(langFromPath(Astro.url.pathname));
---

<section class="stats section--dark on-dark" aria-label="Kirby Chan & Co. at a glance">
  <div class="wrap">
    <dl class="stats__grid">
      {
        dict.home.stats.map((s) => (
          <div class="stat">
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .stats {
    background: var(--ground);
    color: var(--text-on-dark);
    padding-block: var(--sp-7);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-6) var(--sp-5);
    margin: 0;
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
    text-align: center;
  }
  .stat dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3rem);
    font-weight: 600;
    line-height: 1;
    color: var(--brass);
  }
  .stat dt {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
  }

  @media (min-width: 760px) {
    .stats__grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .stat {
      border-inline-start: 1px solid var(--rule-dark);
      padding-inline-start: var(--sp-5);
      text-align: start;
    }
    .stat:first-child {
      border-inline-start: 0;
      padding-inline-start: 0;
    }
  }
</style>
