---
import testimonials from '../data/testimonials.json';

// Excerpts from public Google reviews of Kirby Chan & Co. Real Estate Team, as
// shown on kirbychanandco.com/reviews. Quote exactly and never invent one: that
// would breach RECO advertising rules. Names are shortened for privacy.
interface Testimonial {
  quote: string;
  name: string;
  context?: string;
  neighbourhood?: string;
}
const items = testimonials as Testimonial[];
---

{
  items.length > 0 && (
    <section class="quotes section section--alt">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">In their words</p>
          <h2>What clients say</h2>
          <p class="lede">Excerpts from public Google reviews, quoted as written.</p>
        </div>
        <ul class="quotes__grid" role="list">
          {items.map((t) => (
            <li>
              <figure class="quote">
                <blockquote>
                  <p>{t.quote}</p>
                </blockquote>
                <figcaption>
                  <span class="quote__name">{t.name}</span>
                  {t.context && <span class="quote__ctx">{t.context}</span>}
                  {t.neighbourhood && <span class="quote__ctx">{t.neighbourhood}</span>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <p class="quotes__more">
          <a href="https://kirbychanandco.com/reviews" rel="noopener noreferrer" target="_blank">
            Read all reviews on kirbychanandco.com
          </a>
        </p>
      </div>
    </section>
  )
}

<style>
  .quotes__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--sp-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .quote {
    height: 100%;
    margin: 0;
    padding: var(--sp-6);
    background: #fff;
    border: 1px solid var(--rule);
    border-left: 2px solid var(--brass);
    border-radius: var(--radius-lg);
  }
  .quote blockquote {
    margin: 0;
  }
  .quote blockquote p {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink);
  }
  .quote figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.8rem;
    margin-top: var(--sp-5);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--rule);
    font-size: 0.78rem;
  }
  .quote__name {
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .quotes__more {
    margin-top: var(--sp-6);
    font-size: 0.9rem;
  }
  .quote__ctx {
    color: var(--text-muted);
  }
</style>
