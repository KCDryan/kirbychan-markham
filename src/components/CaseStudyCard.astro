---
interface Props {
  slug: string;
  title: string;
  situation: string;
  result: string;
  placeholder?: boolean;
  feature?: boolean;
}
const { slug, title, situation, result, placeholder = false, feature = false } = Astro.props;
---

<a class:list={['cs', feature && 'cs--feature']} href={`/case-studies/${slug}/`}>
  <span class="cs__eyebrow">From my side of the table</span>
  <h3 class="cs__title">{title}</h3>
  <span class="cs__situation">{situation}</span>
  <span class="cs__result">
    <span class="cs__result-label">Result</span>
    {result}
  </span>
  {placeholder && <span class="todo-badge">Layout sample, not a real client file</span>}
  <span class="cs__cta" aria-hidden="true">Read the full story</span>
</a>

<style>
  .cs {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: var(--sp-6);
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  .cs:hover {
    border-color: var(--brass);
    box-shadow: var(--shadow);
  }
  .cs__eyebrow {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--brass);
  }
  .cs__title {
    font-size: var(--step-2);
    margin: 0;
    max-width: 24ch;
  }
  .cs__situation {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-muted);
    flex: 1;
  }
  .cs__result {
    display: block;
    padding: var(--sp-4);
    background: var(--mist);
    border-left: 2px solid var(--brass);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .cs__result-label {
    display: block;
    font-family: var(--font-body);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 0.25rem;
  }
  .cs__cta {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand);
  }

  @media (min-width: 880px) {
    .cs--feature {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      grid-template-areas:
        'eyebrow result'
        'title result'
        'situation result'
        'cta result';
      column-gap: var(--sp-7);
      align-items: start;
      padding: var(--sp-7);
    }
    .cs--feature .cs__eyebrow {
      grid-area: eyebrow;
    }
    .cs--feature .cs__title {
      grid-area: title;
      font-size: var(--step-3);
    }
    .cs--feature .cs__situation {
      grid-area: situation;
      flex: initial;
    }
    .cs--feature .cs__result {
      grid-area: result;
      align-self: stretch;
    }
    .cs--feature .cs__cta {
      grid-area: cta;
      align-self: end;
      margin-top: var(--sp-4);
    }
  }
</style>
