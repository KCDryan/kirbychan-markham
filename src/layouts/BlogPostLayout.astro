---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import BlogCard from '../components/BlogCard.astro';
import Toc from '../components/Toc.astro';
import DownsizingPromo from '../components/DownsizingPromo.astro';
import Cta from '../components/Cta.astro';
import site from '../data/site.json';
import { longDate, neighbourhoodPath } from '../lib/format';
import { BLOG_CATEGORIES } from '../lib/blog';
import { neighbourhoodPhoto } from '../lib/photos';
import { GUIDES, servicePath } from '../lib/guides';
import { blogPosting, breadcrumbList, faqPage } from '../lib/schema';

interface Props {
  entry: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  minutes: number;
  words: number;
}
const { entry, headings, minutes, words } = Astro.props;
const d = entry.data;
const path = `/blog/${entry.id}/`;
const categoryName = BLOG_CATEGORIES[d.category];
const categoryPath = `/blog/category/${d.category}/`;
const guide = d.guide ? { path: `/${d.guide}/`, label: GUIDES[d.guide].label } : undefined;

// Posts that do not list their own links (agents' quick posts, mostly) get them from the headline,
// description and category, so every post links on to a guide, a neighbourhood and a tool.
const topic = `${d.h1} ${d.description}`;
const HOOD_WORDS: Record<string, RegExp> = {
  unionville: /\bunionville\b/i,
  'markham-village': /\bmarkham village\b/i,
  cornell: /\bcornell\b/i,
  'berczy-village': /\bberczy\b/i,
  cathedraltown: /\bcathedraltown\b/i,
  wismer: /\bwismer\b/i,
  greensborough: /\bgreensborough\b/i,
  'angus-glen': /\bangus glen\b/i,
  'box-grove': /\bbox grove\b/i,
  thornhill: /\bthornhill\b/i,
  'milliken-mills': /\bmilliken\b/i,
  downtown: /\bdowntown markham\b/i,
};
const SERVICE_WORDS: [string, RegExp][] = [
  ['estate-sales', /\b(estate|probate|executor)/i],
  ['separation-and-divorce', /\b(separation|divorce)/i],
  ['new-construction', /\b(pre-construction|new construction|builder)/i],
  ['luxury', /\bluxury\b/i],
  ['upsizing', /\bupsiz/i],
  ['relocation', /\b(relocat|moving to markham|newcomer)/i],
  ['investors', /\b(invest|rental|landlord)/i],
  ['downsizing', /\b(downsiz|reverse mortgage|senior)/i],
  ['first-time-buyers', /\bfirst[- ]time\b/i],
];
const CATEGORY_SERVICE: Partial<Record<string, string>> = {
  downsizing: 'downsizing', buying: 'first-time-buyers', 'costs-and-taxes': 'first-time-buyers', condos: 'downsizing',
  'new-construction': 'new-construction', 'moving-to-markham': 'relocation', investing: 'investors', neighbourhoods: 'relocation', selling: 'downsizing',
};
const TOOLS: Partial<Record<string, { href: string; label: string; note: string }[]>> = (() => {
  const ltt = { href: '/land-transfer-tax-calculator-markham/', label: 'Land transfer tax calculator', note: 'Ontario tax on any price, with the first-time buyer refund.' };
  const mortgage = { href: '/mortgage-calculator-markham/', label: 'Mortgage calculator', note: 'Monthly payment, minimum down payment and the stress test.' };
  const prices = { href: '/markham-house-prices/', label: 'Markham house prices', note: 'The latest TRREB prices by property type and neighbourhood.' };
  const sold = { href: '/sold/', label: 'Markham sold prices', note: 'What homes actually sold for, with a free account.' };
  const downsizeHub = { href: '/best-markham-neighbourhoods-for-downsizing/', label: 'Where to downsize in Markham', note: 'Neighbourhoods with condos, townhomes and bungalows.' };
  const families = { href: '/best-markham-neighbourhoods-for-families/', label: 'Markham neighbourhoods with the most room', note: 'Detached, semi and townhome areas with TRREB prices.' };
  const commuters = { href: '/best-markham-neighbourhoods-for-commuters/', label: 'Markham neighbourhoods by commute', note: 'GO, Viva and highway access by neighbourhood.' };
  return {
    buying: [mortgage, ltt], 'costs-and-taxes': [ltt, mortgage], condos: [downsizeHub, prices], 'new-construction': [mortgage, ltt],
    selling: [prices, sold], market: [prices, sold], downsizing: [downsizeHub, sold], investing: [prices, mortgage],
    neighbourhoods: [families, commuters], 'moving-to-markham': [commuters, families],
  };
})();

const allHoods = await getCollection('neighbourhoods', ({ data }) => !data.draft);
const hoodIds = d.related.length ? d.related : Object.keys(HOOD_WORDS).filter((id) => HOOD_WORDS[id].test(topic)).slice(0, 2);
const linkedHoods = hoodIds
  .map((slug) => allHoods.find((h) => h.id === slug))
  .filter((h): h is CollectionEntry<'neighbourhoods'> => Boolean(h));

const allServices = await getCollection('services', ({ data }) => !data.draft);
const serviceIds = d.relatedServices.length
  ? d.relatedServices
  : [...new Set([...SERVICE_WORDS.filter(([, re]) => re.test(topic)).map(([id]) => id), CATEGORY_SERVICE[d.category]].filter((x): x is string => Boolean(x)))].slice(0, 2);
const linkedServices = serviceIds
  .map((slug) => allServices.find((s) => s.id === slug))
  .filter((s): s is CollectionEntry<'services'> => Boolean(s));
const linkedTools = (TOOLS[d.category] ?? []).filter((t) => t.href !== Astro.url.pathname);

// Related posts: same category first, then the newest of the rest.
const others = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const morePosts = [
  ...others.filter((p) => p.data.category === d.category),
  ...others.filter((p) => p.data.category !== d.category),
].slice(0, 3);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: categoryName, path: categoryPath },
  { name: d.h1, path },
];

// Share image: the neighbourhood photo when the post is about one.
const photoHood = d.neighbourhood ?? (linkedHoods.length === 1 ? linkedHoods[0].id : undefined);
const hoodPhoto = photoHood ? neighbourhoodPhoto(photoHood) : undefined;
const ogImage = hoodPhoto
  ? (await getImage({ src: hoodPhoto, width: 1200, height: 630, format: 'jpg', fit: 'cover' })).src
  : undefined;

const jsonLd = [
  breadcrumbList(crumbs),
  blogPosting({
    headline: d.h1,
    description: d.description,
    path,
    published: d.published,
    updated: d.updated,
    image: ogImage,
    section: categoryName,
    wordCount: words,
    about: d.guide ? GUIDES[d.guide].label.replace(' Guide', '') : `${categoryName} in Markham`,
    author: d.author,
  }),
  faqPage(d.faq),
].filter(Boolean);
---

<Base
  title={d.title}
  description={d.description}
  noindex={d.noindex}
  ogType="article"
  ogImage={ogImage}
  jsonLd={jsonLd}
  article={{ published: d.published, modified: d.updated, section: categoryName }}
>
  <Breadcrumbs crumbs={crumbs} />

  <article>
    <header class="post-hero">
      <div class="wrap-narrow">
        <p class="post-cat"><a href={categoryPath}>{categoryName}</a></p>
        <h1>{d.h1}</h1>
        <p class="lede">{d.subtitle}</p>
        <p class="post-meta">
          <span>By {d.author ? (d.authorTitle ? `${d.author}, ${d.authorTitle}` : d.author) : site.name}</span>
          <span aria-hidden="true">&middot;</span>
          <span>Published <time datetime={d.published.toISOString()}>{longDate(d.published)}</time></span>
          {
            d.updated && (
              <>
                <span aria-hidden="true">&middot;</span>
                <span>Updated <time datetime={d.updated.toISOString()}>{longDate(d.updated)}</time></span>
              </>
            )
          }
          <span aria-hidden="true">&middot;</span>
          <span>{minutes} min read</span>
        </p>
      </div>
    </header>

    <div class="wrap post-body">
      <div class="post-shell">
        <div class="post-main">
          {
            d.showTakeaway && (
              <div class="takeaway">
                <h2>The quick answer</h2>
                <p>{d.takeaway}</p>
              </div>
            )
          }

          {
            guide && (
              <p class="post-guide">
                Part of the <a href={guide.path}>{guide.label}</a>, our complete guide to this topic.
              </p>
            )
          }

          <div class="prose">
            <slot />
          </div>

          <DownsizingPromo />

          <FaqAccordion faq={d.faq} />

          {
            (linkedHoods.length > 0 || linkedServices.length > 0 || linkedTools.length > 0) && (
              <section class="post-links" aria-labelledby="post-links-heading">
                <h2 id="post-links-heading">Keep exploring</h2>
                <ul>
                  {linkedHoods.map((h) => (
                    <li>
                      <a href={neighbourhoodPath(h.id)}>{h.data.name} neighbourhood guide</a>
                      <span>{h.data.personality}</span>
                    </li>
                  ))}
                  {linkedServices.map((s) => (
                    <li>
                      <a href={servicePath(s.id)}>{s.data.name}</a>
                      <span>{s.data.summary}</span>
                    </li>
                  ))}
                  {linkedTools.map((t) => (
                    <li>
                      <a href={t.href}>{t.label}</a>
                      <span>{t.note}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {d.sources.length > 0 && (
          <section class="post-sources" aria-labelledby="post-sources-heading">
            <h2 id="post-sources-heading">Sources</h2>
            <ul>
              {
                d.sources.map((src) => (
                  <li>
                    <a href={src.url} rel="noopener noreferrer" target="_blank">
                      {src.name}
                    </a>
                  </li>
                ))
              }
            </ul>
            <p>Figures and rules were checked against these sources on the date this post was published or last updated.</p>
          </section>
          )}

          <div class="disclaimer">
            <p>
              <strong>Not advice.</strong> This post is general information only. It is not legal,
              tax, mortgage or investment advice. Rules and figures change, so confirm the details
              for your own situation with a qualified professional before acting.
            </p>
            <p>
              <strong>Market data.</strong> Any prices quoted are general information for the period
              stated. They are not an appraisal or an opinion of value for any specific property.
            </p>
          </div>
        </div>

        <aside class="post-aside">
          <Toc headings={headings} />
          <div class="aside-cta on-dark">
            <h2>Questions about this?</h2>
            <p>Talk to Kirby Chan & Co. Real Estate Team. There is no pressure and no obligation.</p>
            <a class="btn btn--brass btn--sm btn--wide" href="/contact/">Get in touch</a>
            <a class="aside-cta__phone" href={site.contact.phoneHref}>{site.contact.phone}</a>
          </div>
        </aside>
      </div>
    </div>
  </article>

  {
    morePosts.length > 0 && (
      <section class="section section--alt">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow">Keep reading</p>
            <h2>More from the blog</h2>
          </div>
          <ul class="related-row" role="list">
            {morePosts.map((p) => (
              <li>
                <BlogCard
                  slug={p.id}
                  title={p.data.h1}
                  subtitle={p.data.subtitle}
                  category={p.data.category}
                  published={p.data.published}
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <Cta />
</Base>

<style>
  .post-hero {
    background: var(--mist);
    border-bottom: 1px solid var(--rule);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4rem);
  }
  .post-cat {
    margin-bottom: var(--sp-4);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .post-cat a {
    color: var(--brand);
    text-decoration: none;
    border-bottom: 1px solid var(--brass);
  }
  .post-hero h1 {
    max-width: 24ch;
  }
  .post-hero .lede {
    margin-top: var(--sp-4);
    max-width: 60ch;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.55rem;
    margin-top: var(--sp-5);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .post-body {
    padding-block: var(--section-y);
  }
  .post-shell {
    display: grid;
    gap: var(--sp-7);
  }
  /* A grid item may not shrink below its content without this, so a wide table
     would widen the page on phones. */
  .post-main {
    min-width: 0;
  }
  .post-main > * + * {
    margin-top: var(--sp-7);
  }
  .post-main .prose {
    max-width: 70ch;
  }

  .post-guide {
    padding: var(--sp-4) var(--sp-5);
    border: 1px solid var(--brass-soft);
    border-radius: var(--radius-lg);
    background: #fff;
    font-weight: 600;
  }
  .post-links h2,
  .post-sources h2 {
    font-size: var(--step-2);
    margin-bottom: var(--sp-4);
  }
  .post-links ul {
    display: grid;
    gap: var(--sp-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-links li {
    display: grid;
    gap: 0.2rem;
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--rule);
  }
  .post-links li a {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 600;
    text-decoration: none;
  }
  .post-links li span {
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .post-sources ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding-inline-start: 1.2em;
  }
  .post-sources p {
    margin-top: var(--sp-3);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .post-aside {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
  }
  .aside-cta {
    padding: var(--sp-5);
    background: var(--ground);
    border-radius: var(--radius-lg);
    color: var(--text-on-dark-muted);
  }
  .aside-cta h2 {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
    margin-bottom: var(--sp-3);
  }
  .aside-cta p {
    font-size: 0.88rem;
    margin-bottom: var(--sp-4);
  }
  .aside-cta__phone {
    display: block;
    margin-top: var(--sp-4);
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-on-dark-muted);
  }

  .related-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
    gap: var(--sp-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 1000px) {
    .post-shell {
      grid-template-columns: minmax(0, 1fr) 270px;
      gap: var(--sp-8);
      align-items: start;
    }
    .post-aside {
      position: sticky;
      top: 100px;
    }
  }
</style>
