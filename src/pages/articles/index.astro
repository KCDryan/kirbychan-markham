---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Cta from '../../components/Cta.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Articles', path: '/articles/' },
];
---

<Page
  title="Markham Real Estate Articles and Guides"
  description="Long form guides to buying and selling in Markham. Neighbourhood comparisons, cost breakdowns and the trade-offs that listing descriptions leave out."
  eyebrow="Read"
  h1="The long answers"
  accent="long"
  lede="Short answers sell houses. Long answers help you choose one. These are written to be the most useful thing on the internet about the question they cover."
  crumbs={crumbs}
>
  <section class="section">
    <div class="wrap">
      {
        articles.length > 0 ? (
          <ul class="list" role="list">
            {articles.map((a) => (
              <li>
                <ArticleCard
                  slug={a.id}
                  title={a.data.h1}
                  subtitle={a.data.subtitle}
                  published={a.data.published}
                  minutes={a.data.readMinutes}
                />
              </li>
            ))}
          </ul>
        ) : (
          <p>The first articles are being written now.</p>
        )
      }
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap-narrow">
      <div class="section-head">
        <h2>What we are <em>writing</em> next</h2>
        <p class="lede">
          The list below is the publishing plan. If there is a Markham question you want answered
          properly, tell us and we will move it up.
        </p>
      </div>
      <ul class="planned">
        <li>What a first home in Markham actually costs, all in</li>
        <li>Cornell or Greensborough, compared street by street</li>
        <li>The Markham school catchment trap and how to check properly</li>
        <li>Selling a Markham house that has been in the family for forty years</li>
        <li>Thornhill and why the Yonge Street line matters more than you think</li>
      </ul>
      <p class="planned__note">
        <span class="todo-badge">TODO: confirm or replace this publishing plan</span>
      </p>
    </div>
  </section>

  <Cta />
</Page>

<style>
  .list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--sp-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .planned {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .planned li {
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--text-muted);
  }
  .planned__note {
    margin-top: var(--sp-5);
    font-size: 0.8rem;
  }
</style>
