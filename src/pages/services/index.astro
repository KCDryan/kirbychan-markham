---
import Page from '../../layouts/Page.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import Cta from '../../components/Cta.astro';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
];
---

<Page
  title="How We Work | Kirby Chan & Co. Markham"
  description="Eight situations we handle in Markham, from first-time buyers and relocation to luxury, estate sales and pre-construction, with the process set out plainly on each page."
  eyebrow="How we help"
  h1="Most people arrive with a situation, not a search"
  accent="situation"
  lede="A job that starts in eight weeks. A parent's house that has to be sold. A condo that has become too small. The work is different in each case, so these pages are written one situation at a time."
  crumbs={crumbs}
>
  <section class="section">
    <div class="wrap">
      <ServiceGrid />
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head">
        <h2>Buying or selling in <em>general</em>?</h2>
        <p class="lede">
          If your situation is simply that you want to buy or sell a home in Markham, start with
          one of these two pages instead.
        </p>
      </div>
      <div class="pair">
        <a class="pair__card" href="/buyers/">
          <h3>For buyers</h3>
          <p>How we search, what we check and how offers actually work in this market.</p>
          <span>Read the buyer page</span>
        </a>
        <a class="pair__card" href="/sellers/">
          <h3>For sellers</h3>
          <p>How we price, prepare and market a Markham home and what we report back to you.</p>
          <span>Read the seller page</span>
        </a>
      </div>
    </div>
  </section>

  <Cta />
</Page>

<style>
  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--sp-5);
  }
  .pair__card {
    display: grid;
    gap: 0.6rem;
    padding: var(--sp-6);
    background: #fff;
    border: 1px solid var(--rule);
    border-top: 2px solid var(--gold);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
  }
  .pair__card:hover {
    border-color: var(--gold);
    box-shadow: var(--shadow);
  }
  .pair__card h3 {
    font-size: var(--step-2);
    margin: 0;
  }
  .pair__card p {
    color: var(--text-muted);
    line-height: 1.6;
  }
  .pair__card span {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brown);
  }
</style>
