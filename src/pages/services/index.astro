---
import Page from '../../layouts/Page.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import Cta from '../../components/Cta.astro';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
];
---

<Page
  title="How We Work | Kirby Chan & Co. Markham"
  description="How we help in Markham: buying, selling, luxury, relocation, downsizing, first-time buyers, new construction, estate sales and separation."
  eyebrow="How we help"
  h1="Most people arrive with a situation, not a search"
  accent="situation"
  lede="A job that starts in eight weeks. A parent's house that has to be sold. A condo that has become too small. The work is different in each case, so these pages are written one situation at a time."
  crumbs={crumbs}
>
  <section class="section">
    <div class="wrap">
      <ServiceGrid level={2} />
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap-narrow prose">
      <h2>Tools and data behind every service</h2>
      <p>
        Whatever the situation, the same evidence sits underneath it. Check what homes cost with
        <a href="/markham-house-prices/">Markham house prices</a> by property type, see
        <a href="/sold/">what nearby homes actually sold for</a> and browse
        <a href="/homes-for-sale/">every Markham home for sale</a> or
        <a href="/homes-for-sale/map/">the same homes on a map</a>.
      </p>
      <p>
        For the numbers on a move, use the <a href="/land-transfer-tax-calculator-markham/">land transfer
        tax calculator</a> and the <a href="/mortgage-calculator-markham/">mortgage calculator</a>. If a
        parent's home is involved, start with <a href="/blog/selling-a-parents-house-markham/">selling a
        parent's house in Markham</a> and <a href="/blog/power-of-attorney-sell-house-ontario/">whether a
        power of attorney can sell a house in Ontario</a>.
      </p>
    </div>
  </section>


  <Cta />
</Page>

