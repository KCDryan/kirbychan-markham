---
/** The old address of a listing, /homes-for-sale/listing/?id=KEY. Each listing now has its own page at /listing/KEY/. */
import Page from '../../layouts/Page.astro';
---

<Page title="Markham Home Listing" description="This address has moved: each home for sale in Markham now has its own page with photos, the asking price, property tax and the listing brokerage." h1="This listing has moved" crumbs={[{ name: 'Home', path: '/' }, { name: 'Homes for Sale', path: '/homes-for-sale/' }]} noindex>
  <section class="section">
    <div class="wrap-narrow">
      <p id="moved">Opening the listing. If nothing happens, <a href="/homes-for-sale/">go back to the list of homes</a>.</p>
    </div>
  </section>
</Page>

<script is:inline>
  (() => {
    const id = (new URLSearchParams(location.search).get('id') || '').toUpperCase();
    location.replace(/^[A-Z]{1,3}\d{5,10}$/.test(id) ? '/listing/' + id + '/' : '/homes-for-sale/');
  })();
</script>
