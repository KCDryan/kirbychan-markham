---
import Page from '../../layouts/Page.astro';
import IdxDisclaimer from '../../components/IdxDisclaimer.astro';
import site from '../../data/site.json';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Homes for Sale', path: '/homes-for-sale/' },
  { name: 'Listing', path: '/homes-for-sale/listing/' },
];
---

<Page
  title="Home for Sale in Markham"
  description="Details, photos and the listing brokerage for a home listed on the MLS®."
  eyebrow="MLS® listing"
  h1="Home for sale"
  crumbs={crumbs}
  noindex
>
  <section class="section">
    <div class="wrap-narrow">
      <p id="status" aria-live="polite">Loading listing…</p>
      <article id="listing" hidden>
        <p class="l__price" id="price"></p>
        <p class="l__meta" id="meta"></p>
        <div class="l__gallery" id="gallery"></div>
        <div class="l__cta">
          <a class="btn btn--primary" id="ask" href="/contact/">Ask about this home</a>
          <a class="btn btn--ghost" href={site.contact.phoneHref}>Call {site.contact.phone}</a>
        </div>
        <div class="prose">
          <h2>About this home</h2>
          <p id="remarks"></p>
          <h2>Details</h2>
          <table><tbody id="facts"></tbody></table>
          <p class="l__brokerage" id="brokerage"></p>
        </div>
      </article>
      <p><a href="/homes-for-sale/">Back to all listings</a></p>
      <IdxDisclaimer />
    </div>
  </section>
</Page>

<script is:inline>
  (() => {
    const $ = (id) => document.getElementById(id);
    const id = new URLSearchParams(location.search).get('id') || '';
    const money = (n) => (typeof n === 'number' ? '$' + n.toLocaleString('en-CA') : '');
    const label = (k) => ({ LivingAreaRange: 'Square feet', ApproximateAge: 'Age', DirectionFaces: 'Faces', TaxAnnualAmount: 'Property tax', AssociationFee: 'Maintenance fee', KitchensTotal: 'Kitchens', RoomsTotal: 'Rooms', ParkingTotal: 'Parking spaces', DaysOnMarket: 'Days on market' })[k]
      || k.replace(/([a-z])([A-Z])/g, '$1 $2');
    const show = (k, v) => (Array.isArray(v) ? v.join(', ') : ['TaxAnnualAmount', 'AssociationFee'].includes(k) ? money(v) : typeof v === 'boolean' ? (v ? 'Yes' : 'No') : String(v));

    fetch('/api/listings?id=' + encodeURIComponent(id))
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((l) => {
        const where = [l.address, l.community, l.city].filter(Boolean).join(', ');
        document.title = `${where || 'Home for sale'} | ${money(l.price)}`;
        document.querySelector('h1').textContent = l.address || `Home in ${l.city}`;
        $('price').textContent = money(l.price) + (l.lease ? '/month' : '');
        $('meta').textContent = [where, l.beds != null && `${l.beds} bed`, l.baths != null && `${l.baths} bath`, l.type, l.crossStreet && `Near ${l.crossStreet}`].filter(Boolean).join(' · ');
        l.photos.forEach((src, i) => {
          const img = document.createElement('img');
          img.src = src;
          img.alt = `${where}, photo ${i + 1} of ${l.photos.length}`;
          img.loading = i ? 'lazy' : 'eager';
          img.referrerPolicy = 'no-referrer';
          $('gallery').append(img);
        });
        $('remarks').textContent = l.remarks || '';
        for (const [k, v] of Object.entries(l.facts)) {
          const tr = document.createElement('tr');
          const th = document.createElement('th');
          const td = document.createElement('td');
          th.textContent = label(k);
          td.textContent = show(k, v);
          tr.append(th, td);
          $('facts').append(tr);
        }
        if (l.tour && /^https:\/\//.test(l.tour)) {
          const a = document.createElement('a');
          a.href = l.tour; a.rel = 'noopener noreferrer'; a.target = '_blank'; a.textContent = 'Virtual tour';
          $('remarks').after(a);
        }
        $('brokerage').textContent = `Listing courtesy of ${l.brokerage || 'the listing brokerage'}. MLS® ${l.key}.`;
        $('ask').href = '/contact/?listing=' + encodeURIComponent(l.key);
        $('status').remove();
        $('listing').hidden = false;
      })
      .catch(() => { $('status').textContent = 'This listing is no longer available or could not be loaded.'; });
  })();
</script>

<style is:global>
  .l__price { font-family: var(--font-heading); font-size: var(--step-4); color: var(--brand); margin: 0; }
  .l__meta { margin: var(--sp-2) 0 var(--sp-5); }
  .l__gallery { display: grid; grid-auto-flow: column; grid-auto-columns: 100%; overflow-x: auto; scroll-snap-type: x mandatory; gap: var(--sp-2); border-radius: var(--radius-lg); }
  .l__gallery img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; scroll-snap-align: start; background: var(--mist); }
  .l__cta { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin: var(--sp-5) 0; }
  .l__brokerage { font-size: var(--step--1); color: var(--text-muted); }
</style>
