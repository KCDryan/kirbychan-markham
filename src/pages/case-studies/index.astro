---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import Cta from '../../components/Cta.astro';

const studies = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Case studies', path: '/case-studies/' },
];
---

<Page
  title="Markham Case Studies | Kirby Chan & Co."
  description="Real Markham transactions written from the agent's side of the table, including what went wrong, what it cost and what we would do differently next time."
  eyebrow="From my side of the table"
  h1="What actually happened, including the part that went wrong"
  accent="wrong"
  lede="A case study with no difficulty in it is an advertisement. These are written to include the moment the deal nearly came apart, because that is the part worth reading."
  crumbs={crumbs}
>
  <section class="section">
    <div class="wrap">
      {
        studies.length > 0 ? (
          <ul class="list" role="list">
            {studies.map((c) => (
              <li>
                <CaseStudyCard
                  slug={c.id}
                  title={c.data.h1}
                  situation={c.data.situation}
                  result={c.data.result}
                  placeholder={c.data.placeholder}
                />
              </li>
            ))}
          </ul>
        ) : (
          <p>Case studies are published as clients give permission to write about their file.</p>
        )
      }
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap-narrow">
      <div class="section-head">
        <h2>Why these are rarer than you would expect</h2>
      </div>
      <p>
        We publish a case study only when the client has given written permission and has seen what
        we intend to say. That rules out most files, including some of the ones we are proudest of.
      </p>
      <p>
        We do not invent composites, we do not merge two clients into one story and we do not
        publish numbers we cannot support. If a page here reads as vague in places, that is usually
        a detail a client asked us to leave out.
      </p>
    </div>
  </section>

  <Cta />
</Page>

<style>
  .list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: var(--sp-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  p + p {
    margin-top: var(--sp-4);
  }
</style>
