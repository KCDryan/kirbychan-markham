---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StatsBand from '../components/StatsBand.astro';
import MarketTicker from '../components/MarketTicker.astro';
import NeighbourhoodGrid from '../components/NeighbourhoodGrid.astro';
import TeamIntro from '../components/TeamIntro.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import WhyMarkham from '../components/WhyMarkham.astro';
import VideoCard from '../components/VideoCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Testimonials from '../components/Testimonials.astro';
import Cta from '../components/Cta.astro';

const videos = (await getCollection('videos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);

const caseStudies = await getCollection('case-studies', ({ data }) => !data.draft);
const featured = caseStudies.find((c) => c.data.featured) ?? caseStudies[0];
---

<Base
  title="Kirby Chan & Co. | Markham Real Estate"
  description="Markham real estate, neighbourhood by neighbourhood. Twelve pillar guides covering prices, property types, schools, transit and the commute, written without the hype."
>
  <Hero />
  <StatsBand />

  <section class="pull section">
    <div class="wrap-narrow">
      <blockquote>
        <p>
          We would rather lose a listing than price it at a number we cannot defend. That is a
          slower way to build a business and it is the only way we know how to work.
        </p>
      </blockquote>
    </div>
  </section>

  <MarketTicker />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The neighbourhoods</p>
        <h2>Markham is not one market. It is <em>twelve</em>.</h2>
        <p class="lede">
          Every guide covers price bands, property types, schools, parks, transit and the commute
          downtown, plus the trade-offs an agent trying to sell you something would leave out.
        </p>
      </div>
      <NeighbourhoodGrid />
    </div>
  </section>

  <TeamIntro />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How we help</p>
        <h2>Most people arrive with a <em>situation</em>, not a search</h2>
        <p class="lede">
          A job that starts in eight weeks. A parent's house that has to be sold. A condo that has
          become too small. The work is different in each case, so the pages are too.
        </p>
      </div>
      <ServiceGrid />
    </div>
  </section>

  <WhyMarkham />

  {
    videos.length > 0 && (
      <section class="section section--alt">
        <div class="wrap">
          <div class="section-head section-head--row">
            <div>
              <p class="eyebrow">Watch</p>
              <h2>
                See it before you <em>drive</em> it
              </h2>
            </div>
            <a class="btn btn--ghost btn--sm" href="/videos/">
              All videos
            </a>
          </div>
          <ul class="card-row" role="list">
            {videos.map((v) => (
              <li>
                <VideoCard
                  slug={v.id}
                  title={v.data.h1}
                  category={v.data.category}
                  minutes={v.data.durationMinutes}
                  youtubeId={v.data.youtubeId}
                  summary={v.data.summary}
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <Testimonials />

  {
    featured && (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow">From my side of the table</p>
            <h2>
              What actually <em>happened</em>, including the part that went wrong
            </h2>
          </div>
          <CaseStudyCard
            slug={featured.id}
            title={featured.data.h1}
            situation={featured.data.situation}
            result={featured.data.result}
            placeholder={featured.data.placeholder}
            feature
          />
        </div>
      </section>
    )
  }

  {
    articles.length > 0 && (
      <section class="section section--alt">
        <div class="wrap">
          <div class="section-head section-head--row">
            <div>
              <p class="eyebrow">Read</p>
              <h2>
                The <em>long</em> answers
              </h2>
            </div>
            <a class="btn btn--ghost btn--sm" href="/articles/">
              All articles
            </a>
          </div>
          <ul class="card-row" role="list">
            {articles.map((a) => (
              <li>
                <ArticleCard
                  slug={a.id}
                  title={a.data.h1}
                  subtitle={a.data.subtitle}
                  published={a.data.published}
                  minutes={a.data.readMinutes}
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <Cta />
</Base>

<style>
  .pull {
    padding-block: var(--sp-8);
    text-align: center;
  }
  .pull blockquote {
    margin: 0;
  }
  .pull blockquote p {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-style: italic;
    line-height: 1.45;
    color: var(--brown);
    text-wrap: balance;
  }

  .section-head--row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-4);
    max-width: none;
  }

  .card-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
    gap: var(--sp-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
